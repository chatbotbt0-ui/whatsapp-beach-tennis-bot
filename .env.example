# Numeros autorizados (separados por virgula, formato internacional sem '+')
# Ex: 5582996198965,5511999999999
AUTHORIZED_NUMBERS=

# IDs das planilhas (separados por virgula, mesma ordem dos números autorizados)
# Ex: 1AbCdEf...,2XyZaBc...
GOOGLE_SHEETS_IDS=

# Caminho para o credentials.json do Service Account
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Cron para lembretes automaticos (default: 9h todos os dias)
REMINDER_CRON=0 9 * * *

TZ=America/Sao_Paulo
